/* ============================================================
   LIGHT THEME — Novel Translator
   Renk Paleti:
     Arkaplan       : #f5f3fa (açık lavanta)
     Panel arkaplan : #ede8f8
     Vurgu          : #9b59d0 (mor/violet)
     Metin          : #1a0d2e (koyu mor)
     Girdi arkaplan : #ffffff
     Kenarlık       : #c9aff0
   ============================================================ */

/* ── Genel Pencere & Widget ── */
QMainWindow,
QDialog {
    background-color: #f5f3fa;
    color: #1a0d2e;
}

QWidget {
    background-color: #f5f3fa;
    color: #1a0d2e;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

/* ── Düğmeler ── */
QPushButton {
    background-color: #9b59d0;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 600;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #b06fe0;
}

QPushButton:pressed {
    background-color: #7a3faa;
}

QPushButton:disabled {
    background-color: #d8cce8;
    color: #a090b8;
}

QPushButton:flat {
    background-color: transparent;
    border: 1px solid #c9aff0;
    color: #9b59d0;
}

QPushButton:flat:hover {
    background-color: #ede8f8;
}

/* ── Metin Girdi Alanları ── */
QLineEdit {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    padding: 5px 9px;
    font-size: 13px;
    selection-background-color: #9b59d0;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #9b59d0;
}

QLineEdit:disabled {
    background-color: #ede8f8;
    color: #a090b8;
    border: 1px solid #d8cce8;
}

QLineEdit::placeholder {
    color: #b8a8d0;
}

/* ── Metin Düzenleyiciler ── */
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    padding: 6px;
    font-size: 13px;
    selection-background-color: #9b59d0;
    selection-color: #ffffff;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #9b59d0;
}

QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #ede8f8;
    color: #a090b8;
}

/* ── Açılır Kutu ── */
QComboBox {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    padding: 5px 9px;
    font-size: 13px;
    min-height: 28px;
}

QComboBox:hover {
    border: 1px solid #9b59d0;
}

QComboBox:focus {
    border: 1px solid #9b59d0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #c9aff0;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #f0ebfc;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9b59d0;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    selection-background-color: #9b59d0;
    selection-color: #ffffff;
    outline: none;
}

QComboBox:disabled {
    background-color: #ede8f8;
    color: #a090b8;
    border: 1px solid #d8cce8;
}

/* ── Liste Widget ── */
QListWidget {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    outline: none;
}

QListWidget::item {
    padding: 5px 8px;
    border-radius: 3px;
}

QListWidget::item:hover {
    background-color: #ede8f8;
}

QListWidget::item:selected {
    background-color: #9b59d0;
    color: #ffffff;
}

/* ── Tablo Widget & Görünümü ── */
QTableWidget,
QTableView {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    gridline-color: #e0d5f5;
    outline: none;
    selection-background-color: #9b59d0;
    selection-color: #ffffff;
}

QTableWidget::item,
QTableView::item {
    padding: 4px 8px;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #f0ebfc;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #9b59d0;
    color: #ffffff;
}

/* ── Başlık Görünümü ── */
QHeaderView {
    background-color: #ede8f8;
    color: #1a0d2e;
    border: none;
}

QHeaderView::section {
    background-color: #ede8f8;
    color: #7a3faa;
    border: none;
    border-right: 1px solid #c9aff0;
    border-bottom: 1px solid #c9aff0;
    padding: 5px 8px;
    font-weight: 600;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: #e0d5f5;
}

QHeaderView::section:checked {
    background-color: #9b59d0;
    color: #ffffff;
}

/* ── Sekme Widget & Çubuğu ── */
QTabWidget {
    background-color: #f5f3fa;
    border: none;
}

QTabWidget::pane {
    background-color: #f5f3fa;
    border: 1px solid #c9aff0;
    border-radius: 5px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: #ede8f8;
    color: #a090b8;
    border: 1px solid #c9aff0;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 7px 16px;
    margin-right: 2px;
    font-size: 13px;
}

QTabBar::tab:hover {
    background-color: #e0d5f5;
    color: #1a0d2e;
}

QTabBar::tab:selected {
    background-color: #f5f3fa;
    color: #9b59d0;
    border-color: #c9aff0;
    border-bottom: 2px solid #9b59d0;
    font-weight: 600;
}

/* ── Kaydırma Çubuğu ── */
QScrollBar:vertical {
    background-color: #ede8f8;
    width: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #c9aff0;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9b59d0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background-color: #ede8f8;
    height: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #c9aff0;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9b59d0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ── İlerleme Çubuğu ── */
QProgressBar {
    background-color: #ede8f8;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    text-align: center;
    color: #1a0d2e;
    font-size: 12px;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #9b59d0;
    border-radius: 4px;
}

/* ── Sayı Girişleri ── */
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 13px;
    min-height: 28px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #9b59d0;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    background-color: #ede8f8;
    border-left: 1px solid #c9aff0;
    border-bottom: 1px solid #c9aff0;
    border-top-right-radius: 5px;
    width: 18px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: #ede8f8;
    border-left: 1px solid #c9aff0;
    border-bottom-right-radius: 5px;
    width: 18px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #9b59d0;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #ede8f8;
    color: #a090b8;
}

/* ── Grup Kutusu ── */
QGroupBox {
    background-color: #f5f3fa;
    border: 1px solid #c9aff0;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 600;
    color: #9b59d0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #9b59d0;
    background-color: #f5f3fa;
    left: 10px;
}

/* ── Bölücü ── */
QSplitter::handle {
    background-color: #c9aff0;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #9b59d0;
}

/* ── Menü Çubuğu ── */
QMenuBar {
    background-color: #ede8f8;
    color: #1a0d2e;
    border-bottom: 1px solid #c9aff0;
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #e0d5f5;
    color: #9b59d0;
}

/* ── Menü ── */
QMenu {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 5px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 16px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #9b59d0;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #c9aff0;
    margin: 4px 8px;
}

/* ── Mesaj Kutusu ── */
QMessageBox {
    background-color: #f5f3fa;
    color: #1a0d2e;
}

QMessageBox QLabel {
    color: #1a0d2e;
    background-color: transparent;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ── Onay Kutusu ── */
QCheckBox {
    color: #1a0d2e;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #c9aff0;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #9b59d0;
}

QCheckBox::indicator:checked {
    background-color: #9b59d0;
    border-color: #9b59d0;
}

QCheckBox::indicator:checked:hover {
    background-color: #b06fe0;
}

QCheckBox:disabled {
    color: #a090b8;
}

QCheckBox::indicator:disabled {
    background-color: #ede8f8;
    border-color: #d8cce8;
}

/* ── Etiket ── */
QLabel {
    color: #1a0d2e;
    background-color: transparent;
}

/* ── Araç İpucu ── */
QToolTip {
    background-color: #ffffff;
    color: #1a0d2e;
    border: 1px solid #9b59d0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Kaydırma Alanı ── */
QScrollArea {
    background-color: #f5f3fa;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #f5f3fa;
}

/* ── Çerçeve ── */
QFrame {
    background-color: transparent;
    border: none;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    background-color: #c9aff0;
    border: none;
    max-height: 1px;
}

/* ── Durum Çubuğu ── */
QStatusBar {
    background-color: #ede8f8;
    color: #7a5a9a;
    border-top: 1px solid #c9aff0;
    font-size: 12px;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

/* ============================================================
   ObjectName Bazlı Stiller
   ============================================================ */

/* Sol panel */
#solPanel {
    background-color: #ede8f8;
}

/* Ayırıcı çizgi */
#ayiriciCizgi {
    background-color: #c9aff0;
    max-height: 1px;
    border: none;
}

/* Başlık etiketi */
#baslikLabel {
    color: #4a1a80;
    font-size: 16px;
    font-weight: 700;
    background-color: transparent;
}

/* Alt başlık etiketi */
#altBaslikLabel {
    color: #7a5a9a;
    font-size: 11px;
    background-color: transparent;
}

/* Bölüm başlık etiketi */
#bolumBaslikLabel {
    color: #7a5a9a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    background-color: transparent;
}

/* Yer tutucu etiketi */
#placeholderLabel {
    color: #b8a8d0;
    font-size: 15px;
    background-color: transparent;
}

/* Hata etiketi */
#hataLabel {
    color: #c0392b;
    font-size: 12px;
    background-color: transparent;
}

/* AI durum etiketi — duruma göre */
#aiDurumLabel[durum="pasif"] {
    color: #7a5a9a;
}

#aiDurumLabel[durum="uyari"] {
    color: #d4850a;
}

#aiDurumLabel[durum="hata"] {
    color: #c0392b;
}

#aiDurumLabel[durum="basarili"] {
    color: #1e8449;
}

/* Tehlikeli düğme */
#tehlikeliButon {
    background-color: #c0392b;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
}

#tehlikeliButon:hover {
    background-color: #e74c3c;
}

#tehlikeliButon:pressed {
    background-color: #a93226;
}

/* İkincil düğme */
#ikincilButon {
    background-color: #ede8f8;
    color: #1a0d2e;
    border: 1px solid #c9aff0;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
}

#ikincilButon:hover {
    background-color: #e0d5f5;
    border-color: #9b59d0;
}

#ikincilButon:pressed {
    background-color: #d5c8f0;
}

/* Sözlük başlık etiketi */
#sozlukBaslikLabel {
    color: #9b59d0;
    font-size: 13px;
    font-weight: 700;
    background-color: transparent;
}